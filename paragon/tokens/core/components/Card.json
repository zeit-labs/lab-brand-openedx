{
  "spacing": {
    "$type": "dimension",
    "card": {
      "margin": {
        "grid-bottom": { "source": "$card-grid-margin-bottom", "$value": "2rem" }
      }
    }
  },
  "size": {
    "$type": "dimension",
    "card": {
      "focus": {
        "border": {
          "width": { "source": "$card-focus-border-width", "$value": "0" }
        }
      },
      "image": {
        "vertical": {
          "max-height": { "source": "$card-image-vertical-max-height", "$value": "200px" }
        },
        "border-radius": { "source": "$card-image-border-radius", "$value": "0.8rem" }
      }
    }
  }
}